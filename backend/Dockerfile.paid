# Isolated paid-product image. No production workflow selects this Dockerfile.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 paid \
    && useradd --uid 10001 --gid paid --create-home --shell /usr/sbin/nologin paid \
    && mkdir -p /data && chown paid:paid /data

WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=paid:paid app ./app

USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=6 \
    CMD python -c "import json, urllib.request; assert json.load(urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)).get('product') == 'paid-features'"
# Forwarded headers are untrusted until a future reviewed proxy policy is installed.
CMD ["uvicorn", "app.paid_main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
